# ==============================================================================
# DevTools AI - Environment Variables Configuration
# Copy this file to .env and provide your secret credentials.
# NEVER commit the active .env file containing real secrets to version control.
# ==============================================================================

# Google Gemini API Configuration (Used server-side by backend only)
# Obtain your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# PostgreSQL Database Configuration
DATABASE_URL=jdbc:postgresql://localhost:5432/devtools_ai
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
POSTGRES_DB=devtools_ai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# JWT Security Key (HS256 minimum 256 bits / 32 characters hex/ascii string)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# Daily Usage Limits
DEVTOOLS_LIMIT_ANONYMOUS=3
DEVTOOLS_LIMIT_FREE=10
DEVTOOLS_LIMIT_PRO=250

# Application Port
PORT=8080
VITE_PORT=5173
